<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <title>Ei Novel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="../css/main.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css">
</head>

<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-light" style="height: 125px;" id="navbar">
    <div class="container-fluid row">
      <a class="navbar-brand d-flex align-items-center col-1" href="/">
        <img src="/images/logo.png" alt="logo" style="height: 40px;">
        <span class="ms-2">Ei Novel</span>
      </a>
      <div style="display: flex;" class="col-3">
        <div class="row">
          <img class="col-3" src="/images/search.png" alt="search" style="height: 40px;">
          <form action="/search" class="col-9" id="search" style="display: flex;justify-content: center;">
            <input class="rounded-pill" type="search" name="q" id="search">
          </form>
        </div>
      </div>
      <div class="collapse navbar-collapse justify-content-center col-6" id="navbarNav-Catagory">
        <ul class="navbar-nav">
          <% categories.forEach(category=> { %>
            <li class="nav-item me-3">
              <a class="nav-link" href="/category/<%= category %>">
                <%= category %>
              </a>
            </li>
            <% }); %>
        </ul>
      </div>
      <div class="collapse navbar-collapse justify-content-end col-2" id="navbarNav-user">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/topup">
              <button class="rounded-pill"
                style="color: rgb(0, 0, 0); background-color: gold; display: flex; justify-content: center; align-items: center;height: 30px;">
                <img src="/images/coin.png" alt="pic-coin" class="img-fluid" style="height: 30px;">
                <span><%= user ? coins : 'Coin' %></span>
              </button>
            </a>
          </li>
          <% if (!user) { %>
            <!-- ยังไม่ login -->
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="/login">
                <button class="rounded-pill" style="color: white; background-color: black;">
                  Login
                </button>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="#" data-bs-toggle="modal"
                data-bs-target="#settingsModal">
                <button class="rounded-pill" style="color: white; background-color: gray;">
                  ⚙️
                </button>
              </a>
            </li>
            <% } else { %>
              <!-- login แล้ว -->
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                  <button class="rounded-pill" style="color: white; background-color: black;">
                    Profile (<%= user.username %>)
                  </button>
                </a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="/account">Account</a></li>
                  <li><a class="dropdown-item" href="/writer">Writer</a></li>
                  <li><a class="dropdown-item" href="#" data-bs-toggle="modal"
                      data-bs-target="#settingsModal">Settings</a></li>
                  <li><a class="dropdown-item" href="/logout">Logout</a></li>
                </ul>
              </li>
              <% } %>
        </ul>
      </div>
  </nav>
  <main>
    <div class="swiper banner-swiper" 
     style="height: 400px; background-color: rgb(238, 236, 236);">
  <div class="swiper-wrapper">
    <div class="swiper-slide">
      <img class="img-fluid" src="<%= mainBanner %>" alt="Main-pic"
        style="width: 100%; height: 100%; object-fit: contain;">
    </div>
    <div class="swiper-slide">
      <img class="img-fluid" src="<%= mainBanner %>" alt="Main-pic"
        style="width: 100%; height: 100%; object-fit: contain;">
    </div>
    <div class="swiper-slide">
      <img class="img-fluid" src="<%= mainBanner %>" alt="Main-pic"
        style="width: 100%; height: 100%; object-fit: contain;">
    </div>
  </div>
</div>
    <% sections.forEach(section=> { %>
      <h2 style="margin-top: 30px; padding: 10px;">
        <%= section.title %>
      </h2>
      <div style="height: 350px; display:flex; justify-content:center; align-items:center;">
        <div class="swiper" style="width: 80%; height: 100%; border-radius: 10px; overflow:hidden;">
          <div class="swiper-wrapper">
            <% section.items.forEach(item=> { %>
              <div class="swiper-slide">
                <h5 style="align-self: center;"><%= item.name %></h5>
                <a href="<%= item.link %>">
                  <img src="<%= item.img %>" alt="รูป" class="img-fluid"
                    style="width: 80%; height: 80%;object-fit: contain;">
                </a>
              </div>
              <% }); %>
          </div>
          <div class="swiper-button-next"></div>
          <div class="swiper-button-prev"></div>
        </div>
      </div>
      <% }); %>

        <!-- Down-swiper -->
        <h2 style="color: pink; margin-top: 80px; padding: 10px;">ท็อปชาร์ตนิยายทุกหมวด</h2>
        <div style="height: 700px; display:flex; justify-content:center; align-items:center;">
          <div class="swiper Down-swiper" style="width: 80%; height: 100%; border-radius: 10px; overflow:hidden;">
            <div class="swiper-wrapper">
              <% topCharts.forEach(book=> { %>
                <div class="swiper-slide">
                  <img src="<%= book.img %>" alt="ปกนิยาย" class="card-img"
                    style="width: 50%; height: 50%; object-fit: contain;">
                  <div class="category">
                    <%= book.category %>
                  </div>
                  <div class="title">
                    <%= book.name %>
                  </div>
                  <div class="desc">
                    <%= book.desc %>
                  </div>
                </div>
                <% }); %>
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
          </div>
        </div>
  </main>

  <!-- Settings Modal -->
  <div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 shadow" id="settings">
        <div class="modal-header">
          <h5 class="modal-title" id="settingsModalLabel">การตั้งค่าเว็บไซต์</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
        </div>
        <div class="modal-body">
          <!-- Font Size -->
          <div class="mb-3">
            <label class="form-label">ขนาดตัวอักษร</label>
            <select id="fontSizeSelect" class="form-select rounded-pill">
              <option value="14px">เล็ก</option>
              <option value="16px" selected>ปกติ</option>
              <option value="20px">ใหญ่</option>
            </select>
          </div>

          <!-- Font Family -->
          <div class="mb-3">
            <label class="form-label">Font</label>
            <select id="fontFamilySelect" class="form-select rounded-pill">
              <option value="Arial, sans-serif" selected>Sans-serif</option>
              <option value="Georgia, serif">Serif</option>
              <option value="Courier New, monospace">Monospace</option>
            </select>
          </div>

          <!-- Theme -->
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="themeSwitch">
            <label class="form-check-label" for="themeSwitch">โหมดมืด</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">ปิด</button>
        </div>
      </div>
    </div>
  </div>

  <footer class="bg-light text-dark mt-5" id="footer">
    <div class="container py-4">
      <div class="row">
        <!-- Column 1: About -->
        <div class="col-md-4">
          <h5>About Us</h5>
          <p>เว็บไซต์สำหรับติดตามนิยายแนวต่าง ๆ และข่าวสารเกี่ยวกับเรื่องโปรดของคุณ</p>
        </div>

        <!-- Column 2: Links -->
        <div class="col-md-4">
          <h5>Links</h5>
          <ul class="list-unstyled">
            <li><a href="#" class="text-decoration-none">Romantic</a></li>
            <li><a href="#" class="text-decoration-none">Fantasy</a></li>
            <li><a href="#" class="text-decoration-none">Mystery</a></li>
            <li><a href="#" class="text-decoration-none">Action</a></li>
          </ul>
        </div>

        <!-- Column 3: Contact -->
        <div class="col-md-4">
          <h5>Contact</h5>
          <p>Email: websiteeinovel@gmail.com</p>
          <p>Phone: +66 123 456 789</p>
        </div>
      </div>

      <div class="text-center mt-3">
        &copy; 2025 MySite. All rights reserved.
      </div>
    </div>
  </footer>
<div id="chat-btn" 
     class="btn btn-primary rounded-circle" 
     style="position: fixed; bottom: 20px; right: 20px; width: 60px; height: 60px; display:flex; justify-content:center; align-items:center; font-size: 24px; z-index: 2000;">
  💬
</div>

<div id="chat-box" 
     class="card shadow" 
     style="position: fixed; bottom: 90px; right: 20px; width: 300px; height: 400px; display: none; flex-direction: column; z-index: 2000;">
  <div class="card-header bg-dark text-white p-2">
    🤖 Chat Bot
  </div>
  <div id="messages" class="card-body overflow-auto" style="font-size: 14px;">
    <b>Bot:</b> สวัสดีครับ! เลือกหัวข้อที่ต้องการ 👇<br><br>
    <button class="btn btn-outline-primary btn-sm w-100 mb-1 topic" data-topic="usage">1. วิธีการใช้งาน</button>
    <button class="btn btn-outline-primary btn-sm w-100 mb-1 topic" data-topic="report">2. รายงานปัญหา</button>
    <button class="btn btn-outline-primary btn-sm w-100 mb-1 topic" data-topic="admin">3. ติดต่อแอดมิน</button>
    <button class="btn btn-outline-primary btn-sm w-100 mb-1 topic" data-topic="point">4. การเติม Point</button>
    <button class="btn btn-outline-primary btn-sm w-100 mb-1 topic" data-topic="breakup">5. ฉันจะเปลี่ยนรหัสผ่านได้ยังไง</button>
  </div>
</div>

  <script src="/js/settings.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.js"></script>
  <script>
    const chatBtn = document.getElementById("chat-btn");
  const chatBox = document.getElementById("chat-box");
  const messages = document.getElementById("messages");

  chatBtn.addEventListener("click", () => {
    chatBox.style.display = chatBox.style.display === "none" ? "flex" : "none";
  });

  document.addEventListener("click", (e) => {
    if (e.target.classList.contains("topic")) {
      const topic = e.target.dataset.topic;
      let reply = "";

      if (topic === "usage") {
        reply = "✅ วิธีการใช้งาน: เลือกนิยาย กดอ่าน หรือค้นหาผ่านแถบ Search ได้เลยครับ";
      } else if (topic === "report") {
        reply = "⚠️ รายงานปัญหา: ส่งอีเมลไปที่ websiteeinovel@einovel.com";
      } else if (topic === "admin") {
        reply = "👨‍💻 ติดต่อแอดมิน: แอดไลน์ @einovel หรือ inbox เพจ Facebook";
      } else if (topic === "point") {
        reply = "💰 เติม Point: ไปที่เมนู 'รูปเหรียญด้านบนขวา' เลือกวิธีชำระเงิน และระบบจะเติมให้อัตโนมัติ";
      } else if (topic === "breakup") {
        reply = `สามารถเปลี่ยนรหัสผ่านได้โดย ออกจากระบบก่อนจากนั้นไปที่ <strong>Login</strong> -> และ <strong>Forget password</strong> ครับ`
      }

      messages.innerHTML += `<div><b>You:</b> ${e.target.innerText}</div>`;
      setTimeout(() => {
        messages.innerHTML += `<div><b>Bot:</b> ${reply}</div>`;
        messages.scrollTop = messages.scrollHeight;
      }, 400);
    }
  });
    const swiper = new Swiper('.swiper', {
      slidesPerView: 3,
      spaceBetween: 2,
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
    });

    const Downswiper = new Swiper('.Down-swiper', {
      slidesPerView: 3,
      grid: {
        rows: 2,
        fill: 'row',
      },
      spaceBetween: 4,
      navigation: {
        nextEl: '.Down-swiper .swiper-button-next',
        prevEl: '.Down-swiper .swiper-button-prev',
      },
    });
  </script>
  <script>
  const bannerSwiper = new Swiper('.banner-swiper', {
    slidesPerView: 1,
    loop: true,
    autoplay: {
      delay: 3000, // 3 วิ
      disableOnInteraction: false
    },
  });
</script>
</body>