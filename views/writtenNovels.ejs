<html lang="th">

<head>
    <meta charset="UTF-8">
    <title>Ei Novel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="../css/main.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light" style="height: 125px;" id="navbar">
        <div class="container-fluid row">
            <a class="navbar-brand d-flex align-items-center col-1" href="/">
                <img src="/images/logo.png" alt="logo" style="height: 40px;">
                <span class="ms-2">Ei Novel</span>
            </a>
            <div style="display: flex;" class="col-3">
                <div class="row">
                    <img class="col-3" src="/images/search.png" alt="search" style="height: 40px;">
                    <form action="/search" class="col-9" id="search" style="display: flex;justify-content: center;">
                        <input class="rounded-pill" type="search" name="q" id="search">
                    </form>
                </div>
            </div>
            <div class="collapse navbar-collapse justify-content-center col-6" id="navbarNav-Catagory">
                <ul class="navbar-nav">
                    <% categories.forEach(category=> { %>
                        <li class="nav-item me-3">
                            <a class="nav-link" href="/category/<%= category %>">
                                <%= category %>
                            </a>
                        </li>
                        <% }); %>
                </ul>
            </div>
            <div class="collapse navbar-collapse justify-content-end col-2" id="navbarNav-user">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="/topup">
                            <button class="rounded-pill"
                                style="color: rgb(0, 0, 0); background-color: gold; display: flex; justify-content: center; align-items: center;height: 30px;">
                                <img src="/images/coin.png" alt="pic-coin" class="img-fluid" style="height: 30px;">
                                <span>
                                    <%= user ? coins : 'Coin' %>
                                </span>
                            </button>
                        </a>
                    </li>
                    <% if (!user) { %>
                        <!-- ยังไม่ login -->
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="/login">
                                <button class="rounded-pill" style="color: white; background-color: black;">
                                    Login
                                </button>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="#" data-bs-toggle="modal"
                                data-bs-target="#settingsModal">
                                <button class="rounded-pill" style="color: white; background-color: gray;">
                                    ⚙️
                                </button>
                            </a>
                        </li>
                        <% } else { %>
                            <!-- login แล้ว -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <button class="rounded-pill" style="color: white; background-color: black;">
                                        Profile (<%= user.username %>)
                                    </button>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/account">Account</a></li>
                                    <li><a class="dropdown-item" href="/writer">Writer</a></li>
                                    <li><a class="dropdown-item" href="#" data-bs-toggle="modal"
                                            data-bs-target="#settingsModal">Settings</a></li>
                                    <li><a class="dropdown-item" href="/logout">Logout</a></li>
                                </ul>
                            </li>
                            <% } %>
                </ul>
            </div>
    </nav>
    <%- include('includes/writer_header.ejs') %>
        <main id="slide-pages"
            class="d-flex flex-column px-5 h-auto vw-100 justify-content-center align-content-center">
            <!-- เผยแพร่ -->
            <div class="m-3 w-auto mb-0 h-auto">
                <div class="d-flex flex-row justify-content-between">
                    <h5 class="p-2 pb-0 fw-bold">งานเขียนที่เผยแพร่แล้ว</h5>
                    <% if (published.length> 0) { %>
                        <button id="addNewNov" class="border rounded p-2 mx-2">+เพิ่มเรื่องใหม่</button>
                        <% } %>
                </div>

                <div id="writtenNov">
                    <% if (published.length> 0) { %>
                        <% published.forEach(novel=> { %>
                            <div
                                class="d-flex justify-content-between align-items-center mb-2 p-2 rounded bg-light w-100">
                                <strong>
                                    <%= novel.title %>
                                </strong>
                                <a href="/works/<%= novel._id %>" class="btn btn-primary btn-sm"
                                    data-id="<%= novel._id %>">แก้ไข</a>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="d-flex flex-column justify-content-center align-items-center text-black py-5 m-2 w-auto rounded-3 h-auto"
                                        style="background-color: rgb(217, 228, 236);">
                                        <img style="width: 100px;"
                                            src="https://cdn-icons-png.flaticon.com/512/5805/5805445.png"
                                            alt="reading icon" />
                                        <p class="text-center" style="font-size: 15px;">
                                            ไม่พบงานเขียนที่เผยแพร่<br>มาเริ่มสร้างนิยายเรื่องแรกของคุณกันเถอะ!
                                        </p>
                                        <a href="/writer/works/new" class="btn btn-primary"
                                            style="width: 180px;">เพิ่มงานเขียนของคุณ</a>
                                    </div>
                                    <% } %>
                </div>
            </div>

            <!-- แบบร่าง -->
            <div class="text-black m-3 w-auto mb-5 h-auto">
                <h5 class="p-2 pb-0 fw-bold">แบบร่าง</h5>

                <div class="draftNov d-flex flex-row flex-wrap py-3 m-2 w-auto rounded-3 h-auto"
                    style="background-color: rgb(217, 228, 236);">
                    <% if (drafts.length> 0) { %>
                        <% drafts.forEach(draft=> { %>
                            <div class="d-flex flex-column justify-content-center align-items-center bg-light m-3 rounded-3"
                                style="width: 250px; height: 350px;">
                                <strong class="p-2">
                                    <%= draft.title %>
                                </strong>
                                <img class="recCovImg border-0 rounded mb-1"
                                    style="width: 200px; height: 300px; object-fit: cover; cursor: pointer;"
                                    src="<%= draft.coverUrl || 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQNUOu5kkYIXpcfVS97f1I42o9MnsCL2RrN_33gNdUYpUNKT9hwBe7Oko7lW_-TQ_Y7kKM&usqp=CAU' %>" />

                                <div class="d-flex flex-row justify-content-center gap-2">
                                    <button class="btn_publishfromDraft border-0 rounded bg-success text-white my-2"
                                        data-id="<%= draft._id %>">เผยแพร่</button>
                                    <a href="/works/<%= draft._id %>" class="btn btn-warning my-2"
                                        data-id="<%= draft._id %>">แก้ไขเรื่องนี้</a>
                                    <button class="btn_deleteromDraft border-0 rounded bg-secondary text-white my-2"
                                        data-id="<%= draft._id %>">ลบ</button>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="d-flex flex-column justify-content-center align-items-center text-black py-5 m-2 w-auto rounded-3 h-auto mx-auto"
                                        style="background-color: rgb(217, 228, 236);">
                                        <img style="width: 100px;"
                                            src="https://cdn-icons-png.flaticon.com/512/5805/5805445.png"
                                            alt="reading icon" />
                                        <p class="text-center" style="font-size: 15px;">ยังไม่มีแบบร่าง</p>
                                    </div>
                                    <% } %>
                </div>
            </div>
        </main>
        <!-- Settings Modal -->
        <div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 shadow" id="settings">
                    <div class="modal-header">
                        <h5 class="modal-title" id="settingsModalLabel">การตั้งค่าเว็บไซต์</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
                    </div>
                    <div class="modal-body">
                        <!-- Font Size -->
                        <div class="mb-3">
                            <label class="form-label">ขนาดตัวอักษร</label>
                            <select id="fontSizeSelect" class="form-select rounded-pill">
                                <option value="14px">เล็ก</option>
                                <option value="16px" selected>ปกติ</option>
                                <option value="20px">ใหญ่</option>
                            </select>
                        </div>

                        <!-- Font Family -->
                        <div class="mb-3">
                            <label class="form-label">Font</label>
                            <select id="fontFamilySelect" class="form-select rounded-pill">
                                <option value="Arial, sans-serif" selected>Sans-serif</option>
                                <option value="Georgia, serif">Serif</option>
                                <option value="Courier New, monospace">Monospace</option>
                            </select>
                        </div>

                        <!-- Theme -->
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="themeSwitch">
                            <label class="form-check-label" for="themeSwitch">โหมดมืด</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary rounded-pill"
                            data-bs-dismiss="modal">ปิด</button>
                    </div>
                </div>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/js/settings.js"></script>
        <script src="/js/draftActions.js"></script>
</body>