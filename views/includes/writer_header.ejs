<header class="vw-100 ">
    <div class="border-bottom p-3 pb-0 ">
        <h3 class="fs-2 fw-bold">หน้านักเขียน</h3>
        <div class="border-0 rounded " style="background-color: rgb(217, 228, 236);">
            
            <!-- ส่วนข้อมูลนักเขียน -->
            <div class="d-flex flex-row justify-content-between flex-grow-1 ">
                <div class="d-flex flex-row p-4">
                    <div class="d-flex flex-column">
                        <img class="profImg border-0 rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover; cursor: pointer;"
                            src="https://freesvg.org/img/abstract-user-flat-4.png" />
                        <input id="profFile" type="file" accept="image/*" style="display:none;">
                    </div>
                    <script src="/js/uploadImage.js"></script>
                    <div class="d-flex flex-column text-black">
                        <label class="fw-bold fs-5 p-5 pb-0"> ชือนักเขียน</label>
                        <label class="fs-6 p-5 pt-0 pb-0"> <%= user.username %></label>
                    </div>
                </div>
                <div class="d-flex flex-row p-3 gap-5 px-5 align-items-center">
                    <!-- justify-content-center align-item-center -->
                    <div class="d-flex flex-column flex-grow-1 justify-items-center text-black" style="width: 90px;">
                        <label class="fw-bold">เรื่องที่แต่ง: </label>
                        <label class=" d-flex text-center"> 0 </label>
                    </div>
                    <div class="d-flex flex-column flex-grow-1 text-black" style="width: 90px;">
                        <label class="fw-bold">ตอนทั้งหมด: </label>
                        <label class=" d-flex text-center"> 0 </label>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="navbar navbar-expand-lg py-0">
            <ul class="navbar-nav">
                <li class="nav-item active fs-5"><a href="/" class="nav-link text-secondary">งานเขียน</a></li>
                <li class="nav-item fs-5"><a href="/sell" class="nav-link text-secondary">ยอดขายและการโอน</a></li>
            </ul>
        </div>
    </div>
</header>