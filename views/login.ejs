<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <title>Log in - Ei Novel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light" style="height: 125px;" id="navbar">
    <div class="container-fluid row">
      <a class="navbar-brand d-flex align-items-center col-1" href="/">
        <img src="/images/logo.png" alt="logo" style="height: 40px;">
        <span class="ms-2">Ei Novel</span>
      </a>
      <div style="display: flex;" class="col-3">
        <div class="row">
          <img class="col-3" src="/images/search.png" alt="search" style="height: 40px;">
          <form action="/search" class="col-9" id="search" style="display: flex;justify-content: center;">
            <input class="rounded-pill" type="search" name="q" id="search">
          </form>
        </div>
      </div>
      <div class="collapse navbar-collapse justify-content-center col-6" id="navbarNav-Catagory">
        <ul class="navbar-nav">
          <% categories.forEach(category=> { %>
            <li class="nav-item me-3">
              <a class="nav-link" href="/category/<%= category %>">
                <%= category %>
              </a>
            </li>
            <% }); %>
        </ul>
      </div>
      <div class="collapse navbar-collapse justify-content-end col-2" id="navbarNav-user">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/topup">
              <button class="rounded-pill"
                style="color: rgb(0, 0, 0); background-color: gold; display: flex; justify-content: center; align-items: center;height: 30px;">
                <img src="/images/coin.png" alt="pic-coin" class="img-fluid" style="height: 30px;">
                <span><%= user ? coins : 'Coin' %></span>
              </button>
            </a>
          </li>
          <% if (!user) { %>
            <!-- ยังไม่ login -->
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="/login">
                <button class="rounded-pill" style="color: white; background-color: black;">
                  Login
                </button>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="#" data-bs-toggle="modal"
                data-bs-target="#settingsModal">
                <button class="rounded-pill" style="color: white; background-color: gray;">
                  ⚙️
                </button>
              </a>
            </li>
            <% } else { %>
              <!-- login แล้ว -->
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                  <button class="rounded-pill" style="color: white; background-color: black;">
                    Profile (<%= user.username %>)
                  </button>
                </a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="/account">Account</a></li>
                  <li><a class="dropdown-item" href="/writer">Writer</a></li>
                  <li><a class="dropdown-item" href="#" data-bs-toggle="modal"
                      data-bs-target="#settingsModal">Settings</a></li>
                  <li><a class="dropdown-item" href="/logout">Logout</a></li>
                </ul>
              </li>
              <% } %>
        </ul>
      </div>
  </nav>
    <main class="d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 200px);">
        <div class="card shadow-lg p-4 rounded-4 frame" style="width: 100%; max-width: 400px;">
            <h2 class="text-center mb-4">LOG IN</h2>
            <form id="form">
                <!-- Email -->
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" name="username" class="form-control rounded-pill" id="username"
                        placeholder="กรอก username">
                </div>

                <!-- Password -->
                <div class="mb-3" style="position: relative;">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" name="password" class="form-control rounded-pill" id="password"
                        placeholder="กรอกรหัสผ่าน">
                    <button type="button"
                        style="background: transparent; position: absolute; left: 87%; top: 50%; border-style: hidden;"
                        onclick="hideAndShowPassword()">
                        <h5 id="eyeButtonIcon">◡</h5>
                    </button>
                </div>

                <!-- Remember me + Forgot -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="remember" name="remember">
                        <label class="form-check-label" for="remember">Remember me</label>
                    </div>
                    <a href="resetPassword" class="text-decoration-none">Forget password?</a>
                </div>

                <!-- alert -->
                <div class="mb-3" id="alert" style="color: red">

                </div>

                <!-- Button -->
                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-dark rounded-pill">Log in</button>
                </div>

                <p class="text-center mt-3">
                    No account? <a href="register">Register</a>
                </p>
                </p>
            </form>
        </div>
    </main>
    <!-- Settings Modal -->
    <div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 shadow" id="settings">
                <div class="modal-header">
                    <h5 class="modal-title" id="settingsModalLabel">การตั้งค่าเว็บไซต์</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
                </div>
                <div class="modal-body">
                    <!-- Font Size -->
                    <div class="mb-3">
                        <label class="form-label">ขนาดตัวอักษร</label>
                        <select id="fontSizeSelect" class="form-select rounded-pill">
                            <option value="14px">เล็ก</option>
                            <option value="16px" selected>ปกติ</option>
                            <option value="20px">ใหญ่</option>
                        </select>
                    </div>

                    <!-- Font Family -->
                    <div class="mb-3">
                        <label class="form-label">Font</label>
                        <select id="fontFamilySelect" class="form-select rounded-pill">
                            <option value="Arial, sans-serif" selected>Sans-serif</option>
                            <option value="Georgia, serif">Serif</option>
                            <option value="Courier New, monospace">Monospace</option>
                        </select>
                    </div>

                    <!-- Theme -->
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="themeSwitch">
                        <label class="form-check-label" for="themeSwitch">โหมดมืด</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">ปิด</button>
                </div>
            </div>
        </div>
    </div>
    <footer class="bg-light text-dark mt-5" id="footer">
        <div class="container py-4">
            <div class="row">
                <!-- Column 1: About -->
                <div class="col-md-4">
                    <h5>About Us</h5>
                    <p>เว็บไซต์สำหรับติดตามนิยายแนวต่าง ๆ และข่าวสารเกี่ยวกับเรื่องโปรดของคุณ</p>
                </div>

                <!-- Column 2: Links -->
                <div class="col-md-4">
                    <h5>Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-decoration-none">Romantic</a></li>
                        <li><a href="#" class="text-decoration-none">Fantasy</a></li>
                        <li><a href="#" class="text-decoration-none">Mystery</a></li>
                        <li><a href="#" class="text-decoration-none">Action</a></li>
                    </ul>
                </div>

                <!-- Column 3: Contact -->
                <div class="col-md-4">
                    <h5>Contact</h5>
                    <p>Email: websiteeinovel@gmail.com</p>
                    <p>Phone: +66 123 456 789</p>
                </div>
            </div>

            <div class="text-center mt-3">
                &copy; 2025 MySite. All rights reserved.
            </div>
        </div>
    </footer>
    <script>
        function hideAndShowPassword() {
            const password = document.getElementById("password");
            const buttonIcon = document.getElementById("eyeButtonIcon");

            const type = password.getAttribute("type") === "password" ? "text" : "password";
            password.setAttribute("type", type);
            if (type === "password") {
                buttonIcon.innerText = "◡";
            }
            else {
                buttonIcon.innerHTML = "👁";
            }
        }
        const form = document.getElementById("form")
        form.addEventListener("submit", async () => {
            event.preventDefault();
            const username = document.getElementById("username");
            const password = document.getElementById("password");
            const alert = document.getElementById("alert");
            alert.innerHTML = ""
            username.classList.remove("shake")
            password.classList.remove("shake")
            if (username.value.trim() == "") {
                const msg = document.createElement("h6")
                msg.innerHTML = "กรุณากรอก Username"
                alert.appendChild(msg)

                requestAnimationFrame(() => {
                    username.classList.add("shake")
                })
                return
            }
            if (password.value.trim() == "") {
                const msg = document.createElement("h6")
                msg.innerHTML = "กรุณากรอก Password"
                alert.appendChild(msg)

                requestAnimationFrame(() => {
                    password.classList.add("shake")
                })
                return
            }
            const usernameValue = document.getElementById("username").value.trim()
            const passwordValue = document.getElementById("password").value.trim()
            const remember = document.getElementById("remember").checked ? 1 : 0;
            try {
                const res = await fetch("/login", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ usernameValue, passwordValue, remember })
                });

                const respond = await res.json();

                if (!res.ok) {
                    alert.innerHTML = `<h6>${respond.msg}</h6>`;
                    username.classList.remove("shake")
                    password.classList.remove("shake")
                    requestAnimationFrame(()=>{
                        username.classList.add("shake")
                        password.classList.add("shake")
                    })
                } else {
                    //ถ้าไม่มีปัญหาให้ไปยังหน้า home
                    window.location.href = respond.redirect;
                }
            } catch (err) {
                alert.innerHTML = "<h6>เกิดข้อผิดพลาด ลองใหม่อีกครั้ง</h6>";
            }
        })
    </script>
    <script src="/js/settings.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>