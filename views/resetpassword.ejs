<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <title>Reset Password - Ei Novel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light" style="height: 125px;" id="navbar">
    <div class="container-fluid row">
      <a class="navbar-brand d-flex align-items-center col-1" href="/">
        <img src="/images/logo.png" alt="logo" style="height: 40px;">
        <span class="ms-2">Ei Novel</span>
      </a>
      <div style="display: flex;" class="col-3">
        <div class="row">
          <img class="col-3" src="/images/search.png" alt="search" style="height: 40px;">
          <form action="/search" class="col-9" id="search" style="display: flex;justify-content: center;">
            <input class="rounded-pill" type="search" name="q" id="search">
          </form>
        </div>
      </div>
      <div class="collapse navbar-collapse justify-content-center col-6" id="navbarNav-Catagory">
        <ul class="navbar-nav">
          <% categories.forEach(category=> { %>
            <li class="nav-item me-3">
              <a class="nav-link" href="/category/<%= category %>">
                <%= category %>
              </a>
            </li>
            <% }); %>
        </ul>
      </div>
      <div class="collapse navbar-collapse justify-content-end col-2" id="navbarNav-user">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/topup">
              <button class="rounded-pill"
                style="color: rgb(0, 0, 0); background-color: gold; display: flex; justify-content: center; align-items: center;height: 30px;">
                <img src="/images/coin.png" alt="pic-coin" class="img-fluid" style="height: 30px;">
                <span><%= user ? coins : 'Coin' %></span>
              </button>
            </a>
          </li>
          <% if (!user) { %>
            <!-- ยังไม่ login -->
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="/login">
                <button class="rounded-pill" style="color: white; background-color: black;">
                  Login
                </button>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="#" data-bs-toggle="modal"
                data-bs-target="#settingsModal">
                <button class="rounded-pill" style="color: white; background-color: gray;">
                  ⚙️
                </button>
              </a>
            </li>
            <% } else { %>
              <!-- login แล้ว -->
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                  <button class="rounded-pill" style="color: white; background-color: black;">
                    Profile (<%= user.username %>)
                  </button>
                </a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="/account">Account</a></li>
                  <li><a class="dropdown-item" href="/writer">Writer</a></li>
                  <li><a class="dropdown-item" href="#" data-bs-toggle="modal"
                      data-bs-target="#settingsModal">Settings</a></li>
                  <li><a class="dropdown-item" href="/logout">Logout</a></li>
                </ul>
              </li>
              <% } %>
        </ul>
      </div>
  </nav>
    <main class="d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 200px);">
        <div class="card shadow-lg p-4 rounded-4 frame" style="width: 100%; max-width: 400px;">
            <h2 class="text-center mb-4">Reset your password</h2>
            <form action="/resetPassword" method="POST" id="form">
                <!-- Email -->
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="text" name="email" class="form-control rounded-pill" id="email"
                        placeholder="กรอก email">
                    <button type="button" id="sendOtpBtn"
                        style="margin-top: 2px; border-style: none; background-color: white; color: blue; text-decoration: underline;"
                        onclick="sendOTP()">Click Here To Send OTP</button>
                </div>
                <!-- OTP -->
                <div class="mb-3">
                    <label for="otp" class="form-label">OTP</label>
                    <input type="text" name="text" class="form-control rounded-pill" id="otp"
                        placeholder="กรอกรหัส OTP">
                </div>
                <!-- Password -->
                <div class="mb-3" style="position: relative;">
                    <label for="password" class="form-label">New password</label>
                    <input type="password" name="password" class="form-control rounded-pill" id="password"
                        placeholder="กรอกรหัสผ่านใหม่">
                    <button type="button"
                        style="background: transparent; position: absolute; right: 15px; top: 50%; border-style: hidden;"
                        onclick="hideAndShowPassword()">
                        <h5 id="eyeButtonIcon">◡</h5>
                    </button>
                </div>
                <!-- Confirm Password -->
                <div class="mb-3">
                    <label for="confirmPassword" class="form-label">Confirm password</label>
                    <input type="password" class="form-control rounded-pill" id="confirmPassword"
                        placeholder="ยืนยันรหัสผ่าน">
                </div>
                <!-- alert -->
                <div class="mb-3" style="color: red;" id="alert">

                </div>
                <!-- Button -->
                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-dark rounded-pill">Change password</button>
                </div>

                <p class="text-center mt-3">
                    <a href="login">Login</a><small> | </small><a href="register">Register</a>
                </p>
                </p>
            </form>
        </div>
    </main>
    <!-- Settings Modal -->
    <div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 shadow" id="settings">
                <div class="modal-header">
                    <h5 class="modal-title" id="settingsModalLabel">การตั้งค่าเว็บไซต์</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
                </div>
                <div class="modal-body">
                    <!-- Font Size -->
                    <div class="mb-3">
                        <label class="form-label">ขนาดตัวอักษร</label>
                        <select id="fontSizeSelect" class="form-select rounded-pill">
                            <option value="14px">เล็ก</option>
                            <option value="16px" selected>ปกติ</option>
                            <option value="20px">ใหญ่</option>
                        </select>
                    </div>

                    <!-- Font Family -->
                    <div class="mb-3">
                        <label class="form-label">Font</label>
                        <select id="fontFamilySelect" class="form-select rounded-pill">
                            <option value="Arial, sans-serif" selected>Sans-serif</option>
                            <option value="Georgia, serif">Serif</option>
                            <option value="Courier New, monospace">Monospace</option>
                        </select>
                    </div>

                    <!-- Theme -->
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="themeSwitch">
                        <label class="form-check-label" for="themeSwitch">โหมดมืด</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">ปิด</button>
                </div>
            </div>
        </div>
    </div>
    <footer class="bg-light text-dark mt-5" id="footer">
        <div class="container py-4">
            <div class="row">
                <!-- Column 1: About -->
                <div class="col-md-4">
                    <h5>About Us</h5>
                    <p>เว็บไซต์สำหรับติดตามนิยายแนวต่าง ๆ และข่าวสารเกี่ยวกับเรื่องโปรดของคุณ</p>
                </div>

                <!-- Column 2: Links -->
                <div class="col-md-4">
                    <h5>Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-decoration-none">Romantic</a></li>
                        <li><a href="#" class="text-decoration-none">Fantasy</a></li>
                        <li><a href="#" class="text-decoration-none">Mystery</a></li>
                        <li><a href="#" class="text-decoration-none">Action</a></li>
                    </ul>
                </div>

                <!-- Column 3: Contact -->
                <div class="col-md-4">
                    <h5>Contact</h5>
                    <p>Email: websiteeinovel@gmail.com</p>
                    <p>Phone: +66 123 456 789</p>
                </div>
            </div>

            <div class="text-center mt-3">
                &copy; 2025 MySite. All rights reserved.
            </div>
        </div>
    </footer>
    <script>
        function hideAndShowPassword() {
            const password = document.getElementById("password");
            const confirmPassword = document.getElementById("confirmPassword");
            const buttonIcon = document.getElementById("eyeButtonIcon");

            const type = password.getAttribute("type") === "password" ? "text" : "password";
            confirmPassword.setAttribute("type", type);
            password.setAttribute("type", type);
            if (type === "password") {
                buttonIcon.innerText = "◡";
            }
            else {
                buttonIcon.innerHTML = "👁";
            }
        }
        function isValidEmail(email) {
            // ^: เริ่มต้น, $: สิ้นสุด
            // [^\s@]+: ตัวอักษรใดก็ได้ ยกเว้น space และ @
            // @: ต้องมี @
            // [^\s@]+\.: ตัวอักษรก่อน dot
            // [^\s@]{2,}$: หลัง dot ต้องมีอย่างน้อย 2 ตัว
            const emailRegex = /^[^\s@]+@([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}$/;
            return emailRegex.test(email);
        }
        async function sendOTP() {
            const email = document.getElementById("email");
            const sendOtpBtn = document.getElementById("sendOtpBtn");
            email.classList.remove("shake")
            sendOtpBtn.textContent = "Click Here To Send OTP"
            sendOtpBtn.style.color = "blue"
            let timeOut = null;
            clearTimeout(timeOut)
            if (!email.value.trim()) {
                sendOtpBtn.textContent = "กรุณากรอก Email ก่อน!"
                sendOtpBtn.style.color = "red"
                requestAnimationFrame(() => {
                    email.classList.add("shake")
                })
                timeout = setTimeout(() => {
                    sendOtpBtn.textContent = "Click Here To Send OTP"
                    sendOtpBtn.style.color = "blue"
                }, 1000)
                return;
            }
            // ตรวจสอบรูปแบบก่อน
            if (!isValidEmail(email.value.trim())) {
                sendOtpBtn.textContent = "Email ไม่ถูกต้อง!";
                sendOtpBtn.style.color = "red";
                requestAnimationFrame(() => {
                    email.classList.add("shake")
                })
                timeout = setTimeout(() => {
                    sendOtpBtn.textContent = "Click Here To Send OTP"
                    sendOtpBtn.style.color = "blue"
                }, 1000)
                return;
            }

            let dots = 0;
            const timeInterval = setInterval(() => {
                dots = (dots % 3) + 1; 
                sendOtpBtn.textContent = "Sending OTP" + ".".repeat(dots);
                sendOtpBtn.style.color = "orange"
            }, 500);

            try {
                const res = await fetch("/send-otp", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ email: email.value.trim() })
                });

                const alert = await res.json();
                clearInterval(timeInterval);
                if (res.ok) {
                    sendOtpBtn.innerText = "Sent OTP!";
                    sendOtpBtn.style.color = "green";
                } else {
                    showAlert(alert.message);
                }
            } catch (err) {
                console.error(err);
                showAlert("เกิดข้อผิดพลาดในการส่ง OTP");
            }
        }

        const form = document.getElementById("form");
        form.addEventListener("submit", async (event) => {
            event.preventDefault(); // ป้องกันหน้า reload

            const password = document.getElementById("password");
            const confirmPassword = document.getElementById("confirmPassword");
            const email = document.getElementById("email");
            const otp = document.getElementById("otp");
            const alertBox = document.getElementById("alert");
            const sendOtpBtn = document.getElementById("sendOtpBtn");
            alertBox.innerHTML = "";

            email.classList.remove("shake")
            otp.classList.remove("shake")
            password.classList.remove("shake")
            confirmPassword.classList.remove("shake")
            sendOtpBtn.classList.remove("shake")

            // เช็ค validation ฝั่ง client
            let hasError = false;
            if (email.value.trim() === "" || !email.value.includes("@") || !email.value.includes(".") || email.value.split("@").length > 2) {
                const msg = document.createElement("h6");
                msg.innerHTML = "Email ไม่ถูกต้อง";
                alertBox.appendChild(msg);
                requestAnimationFrame(() => {
                    email.classList.add("shake")
                })
                hasError = true;
            }

            if (otp.value.trim() === "") {
                const msg = document.createElement("h6");
                msg.innerHTML = "กรุณากรอก OTP";
                alertBox.appendChild(msg);
                requestAnimationFrame(() => {
                    otp.classList.add("shake")
                })
                hasError = true;
            }

            if (password.value.trim() === "") {
                const msg = document.createElement("h6");
                msg.innerHTML = "Password ไม่ถูกต้อง";
                alertBox.appendChild(msg);
                requestAnimationFrame(() => {
                    password.classList.add("shake")
                    confirmPassword.classList.add("shake")
                })
                hasError = true;
            }
            else if (password.value.trim() !== confirmPassword.value.trim()) {
                const msg = document.createElement("h6");
                msg.innerHTML = "รหัสผ่านไม่ตรงกัน";
                alertBox.appendChild(msg);
                requestAnimationFrame(() => {
                    password.classList.add("shake")
                    confirmPassword.classList.add("shake")
                })
                hasError = true;
            }

            if (hasError) return;

            // ส่งข้อมูลไป server
            try {
                const res = await fetch("/resetPassword", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        email: email.value.trim(),
                        otp: otp.value.trim(),
                        newPassword: password.value.trim()
                    })
                });

                const alert = await res.json();

                if (res.ok) {
                    alertBox.innerHTML = `<h6 style="color: green;">${alert.message}</h6>`;
                    setTimeout(() => {
                        window.location.href = "/login";
                    }, 1000);
                } else {
                    if (alert.status === 0) {
                        requestAnimationFrame(() => {
                            sendOtpBtn.classList.add("shake")
                            sendOtpBtn.style.color = "red"
                            setTimeout(() => {
                                sendOtpBtn.style.color = "blue"
                            }, 500)
                        })
                    }
                    else if (alert.status === 1) {
                        sendOtpBtn.innerHTML = "Click Here To Send OTP Again!"
                        sendOtpBtn.style.color = "green"
                        requestAnimationFrame(() => {
                            sendOtpBtn.classList.add("shake")
                        })
                    }
                    else if (alert.status === 2) {
                        requestAnimationFrame(() => {
                            otp.classList.add("shake")
                        })
                    }
                    alertBox.innerHTML = `<h6 style="color: red;">${alert.message}</h6>`;
                }
            } catch (err) {
                console.error(err);
                alertBox.innerHTML = `<h6 style="color: red;">เกิดข้อผิดพลาด</h6>`;
            }
        });
    </script>
    <script src="/js/settings.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>