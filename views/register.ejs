<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <title>Register - Ei Novel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="./css/main.css">
  <style>
    form {
      text-align: left;
      display: block;
    }
  </style>
  <script>
    // ตั้งธีมจาก localStorage ทันทีที่โหลด (กันกะพริบ)
    (function () {
      const saved = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-bs-theme', saved);
    })();
  </script>

</head>

<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-light" style="height: 125px;" id="navbar">
    <div class="container-fluid row">
      <a class="navbar-brand d-flex align-items-center col-1" href="/">
        <img src="/images/logo.png" alt="logo" style="height: 40px;">
        <span class="ms-2">Ei Novel</span>
      </a>
      <div style="display: flex;" class="col-3">
        <div class="row">
          <img class="col-3" src="/images/search.png" alt="search" style="height: 40px;">
          <form action="/search" class="col-9" id="search" style="display: flex;justify-content: center;">
            <input class="rounded-pill" type="search" name="q" id="search">
          </form>
        </div>
      </div>
      <div class="collapse navbar-collapse justify-content-center col-6" id="navbarNav-Catagory">
        <ul class="navbar-nav">
          <% categories.forEach(category=> { %>
            <li class="nav-item me-3">
              <a class="nav-link" href="/category/<%= category %>">
                <%= category %>
              </a>
            </li>
            <% }); %>
        </ul>
      </div>
      <div class="collapse navbar-collapse justify-content-end col-2" id="navbarNav-user">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/topup">
              <button class="rounded-pill"
                style="color: rgb(0, 0, 0); background-color: gold; display: flex; justify-content: center; align-items: center;height: 30px;">
                <img src="/images/coin.png" alt="pic-coin" class="img-fluid" style="height: 30px;">
                <span><%= user ? coins : 'Coin' %></span>
              </button>
            </a>
          </li>
          <% if (!user) { %>
            <!-- ยังไม่ login -->
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="/login">
                <button class="rounded-pill" style="color: white; background-color: black;">
                  Login
                </button>
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="#" data-bs-toggle="modal"
                data-bs-target="#settingsModal">
                <button class="rounded-pill" style="color: white; background-color: gray;">
                  ⚙️
                </button>
              </a>
            </li>
            <% } else { %>
              <!-- login แล้ว -->
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                  <button class="rounded-pill" style="color: white; background-color: black;">
                    Profile (<%= user.username %>)
                  </button>
                </a>
                <ul class="dropdown-menu">
                  <li><a class="dropdown-item" href="/account">Account</a></li>
                  <li><a class="dropdown-item" href="/writer">Writer</a></li>
                  <li><a class="dropdown-item" href="#" data-bs-toggle="modal"
                      data-bs-target="#settingsModal">Settings</a></li>
                  <li><a class="dropdown-item" href="/logout">Logout</a></li>
                </ul>
              </li>
              <% } %>
        </ul>
      </div>
  </nav>
  <main class="d-flex justify-content-center align-items-start mt-5">
    <div class="container d-flex justify-content-center py-5 frame">
      <div class="card shadow p-4 rounded-4" style="width: 400px;">
        <h3 class="text-center mb-4">Register</h3>
        <form id="registerForm" action="/register" method="POST">
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" id="username" name="username" class="form-control rounded-pill"
              placeholder="กรอก username">
            <small id="usernameFeedback" style="color: red;"></small>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control rounded-pill" placeholder="กรอก Email">
            <small id="emailFeedback" style="color: red;"></small>
          </div>
          <div class="mb-3" style="position: relative;">
            <label for="password" class="form-label">Password</label>
            <input type="password" id="password" name="password" class="form-control rounded-pill"
              placeholder="กรอกรหัสผ่าน">
            <button type="button"
              style="background: transparent; position: absolute; left: 88%; top: 50%; border-style: hidden;"
              onclick="hideAndShowPassword()">
              <h5 id="eyeButtonIcon">◡</h5>
            </button>
          </div>
          <div class="mb-3">
            <label for="confirmPassword" class="form-label">Confirm password</label>
            <input type="password" id="confirmPassword" name="password2" class="form-control rounded-pill"
              placeholder="กรอกรหัสผ่านอีกครั้ง">
          </div>
          <small id="alert" style="color: red;"></small>
          <button type="submit" class="btn btn-success w-100 rounded-pill">Confirm</button>
        </form>
        <p class="text-center mt-3">
          Already have an account? <a href="login">Log in</a>
        </p>
      </div>
    </div>
  </main>
  <!-- Settings Modal -->
  <div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true"
    id="settings">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 shadow" id="settings">
        <div class="modal-header">
          <h5 class="modal-title" id="settingsModalLabel">การตั้งค่าเว็บไซต์</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="ปิด"></button>
        </div>
        <div class="modal-body">
          <!-- Font Size -->
          <div class="mb-3">
            <label class="form-label">ขนาดตัวอักษร</label>
            <select id="fontSizeSelect" class="form-select rounded-pill">
              <option value="14px">เล็ก</option>
              <option value="16px" selected>ปกติ</option>
              <option value="20px">ใหญ่</option>
            </select>
          </div>

          <!-- Font Family -->
          <div class="mb-3">
            <label class="form-label">Font</label>
            <select id="fontFamilySelect" class="form-select rounded-pill">
              <option value="Arial, sans-serif" selected>Sans-serif</option>
              <option value="Georgia, serif">Serif</option>
              <option value="Courier New, monospace">Monospace</option>
            </select>
          </div>

          <!-- Theme -->
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="themeSwitch">
            <label class="form-check-label" for="themeSwitch">โหมดมืด</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">ปิด</button>
        </div>
      </div>
    </div>
  </div>
  <footer class="bg-light text-dark mt-5" id="footer">
    <div class="container py-4">
      <div class="row">
        <!-- Column 1: About -->
        <div class="col-md-4">
          <h5>About Us</h5>
          <p>เว็บไซต์สำหรับติดตามนิยายแนวต่าง ๆ และข่าวสารเกี่ยวกับเรื่องโปรดของคุณ</p>
        </div>

        <!-- Column 2: Links -->
        <div class="col-md-4">
          <h5>Links</h5>
          <ul class="list-unstyled">
            <li><a href="#" class="text-decoration-none">Romantic</a></li>
            <li><a href="#" class="text-decoration-none">Fantasy</a></li>
            <li><a href="#" class="text-decoration-none">Mystery</a></li>
            <li><a href="#" class="text-decoration-none">Action</a></li>
          </ul>
        </div>

        <!-- Column 3: Contact -->
        <div class="col-md-4">
          <h5>Contact</h5>
          <p>Email: websiteeinovel@gmail.com</p>
          <p>Phone: +66 123 456 789</p>
        </div>
      </div>

      <div class="text-center mt-3">
        &copy; 2025 MySite. All rights reserved.
      </div>
    </div>
  </footer>
  <script>
    function hideAndShowPassword() {
      const password = document.getElementById("password");
      const confirmPassword = document.getElementById("confirmPassword");
      const buttonIcon = document.getElementById("eyeButtonIcon");

      const newType = password.type === "password" ? "text" : "password";
      password.type = newType;
      confirmPassword.type = newType;
      if (newType === "password") {
        buttonIcon.innerText = "◡";
      }
      else {
        buttonIcon.innerHTML = "👁";
      }
    }

    //เช็คว่ามี username อยู่ในระบบแล้วหรือยัง
    const usernameInput = document.getElementById("username");
    const usernameFeedback = document.getElementById("usernameFeedback");
    let isUsernameExist = false;

    let timeoutUsername = null;

    usernameInput.addEventListener("input", () => {
      clearTimeout(timeoutUsername);

      timeoutUsername = setTimeout(async () => {
        const username = usernameInput.value.trim();
        if (!username) {
          usernameFeedback.textContent = "";
          return;
        }

        try {
          const res = await fetch(`/check-username?username=${encodeURIComponent(username)}`);
          const user = await res.json();
          if (user.exists) {
            usernameFeedback.textContent = "Username นี้มีคนใช้แล้ว!";
            usernameFeedback.style.color = "red";
            isUsernameExist = true;
          } else {
            usernameFeedback.textContent = "Username สามารถใช้ได้";
            usernameFeedback.style.color = "green";
            isUsernameExist = false;
          }
        } catch (err) {
          console.error(err);
        }
      }, 500);
    });

    //เช็คว่ามี email อยู่ในระบบแล้วหรือยัง
    function isValidEmail(email) {
      // ^: เริ่มต้น, $: สิ้นสุด
      // [^\s@]+: ตัวอักษรใดก็ได้ ยกเว้น space และ @
      // @: ต้องมี @
      // [^\s@]+\.: ตัวอักษรก่อน dot
      // [^\s@]{2,}$: หลัง dot ต้องมีอย่างน้อย 2 ตัว
      const emailRegex = /^[^\s@]+@([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}$/;
      return emailRegex.test(email);
    }
    const emailInput = document.getElementById("email");
    const emailFeedback = document.getElementById("emailFeedback");
    let isEmailExist = false;

    let timeoutEmail = null;

    emailInput.addEventListener("input", () => {
      clearTimeout(timeoutEmail);

      timeoutEmail = setTimeout(async () => {
        const email = emailInput.value.trim();
        if (!email) {
          emailFeedback.textContent = "";
          return;
        }
        // ตรวจสอบรูปแบบก่อน
        if (!isValidEmail(email)) {
          emailFeedback.textContent = "Email ไม่ถูกต้อง!";
          emailFeedback.style.color = "red";
          isEmailExist = true;
          return;
        }
        try {
          const res = await fetch(`/check-email?email=${encodeURIComponent(email)}`);
          const em = await res.json();
          if (em.exists) {
            emailFeedback.textContent = "Email นี้มีคนใช้แล้ว!";
            emailFeedback.style.color = "red";
            isEmailExist = true;
          }
          else {
              emailFeedback.textContent = "Email สามารถใช้ได้";
              emailFeedback.style.color = "green";
              isEmailExist = false;
          }
        } catch (err) {
          console.error(err);
        }
      }, 500);
    });

    const registerForm = document.getElementById("registerForm");
    registerForm.addEventListener("submit", () => {
            const username = document.getElementById("username")
            const email = document.getElementById("email")
            const password = document.getElementById("password")
            const confirmPassword = document.getElementById("confirmPassword")
            const alert = document.getElementById("alert")
            username.classList.remove("shake")
            email.classList.remove("shake")
            password.classList.remove("shake")
            confirmPassword.classList.remove("shake")
            alert.innerHTML = ""
            if (username.value.trim() == "") {
                event.preventDefault()
                const msg = document.createElement("h6");
                msg.innerHTML = "กรุณากรอก Username"
                alert.appendChild(msg)

                requestAnimationFrame(() => {
                    username.classList.add("shake")
                })
            }
            if (email.value.trim() == "") {
                event.preventDefault()
                const msg = document.createElement("h6");
                msg.innerHTML = "กรุณากรอก Email"
                alert.appendChild(msg)

                requestAnimationFrame(() => {
                    email.classList.add("shake")
                })
            }
            if (password.value.trim() == "") {
                event.preventDefault()
                const msg = document.createElement("h6");
                msg.innerHTML = "กรุณากรอก Password"
                alert.appendChild(msg)

                requestAnimationFrame(() => {
                    password.classList.add("shake")
                    confirmPassword.classList.add("shake")
                })
            }
            else if (password.value.trim() !== confirmPassword.value.trim()) {
                event.preventDefault()
                const msg = document.createElement("h6");
                msg.innerHTML = "Password ไม่ตรงกัน"
                alert.appendChild(msg)

                requestAnimationFrame(() => {
                    password.classList.add("shake")
                    confirmPassword.classList.add("shake")
                })
            }
            else if (password.value.trim().length < 6){
              event.preventDefault()
              const msg = document.createElement("h6");
              msg.innerHTML = "Password ต้องมีอย่างน้อย 6 ตัว"
              alert.appendChild(msg)
              requestAnimationFrame(() => {
                    password.classList.add("shake")
                    confirmPassword.classList.add("shake")
                })
            }
            if (isUsernameExist) {
                event.preventDefault()

                requestAnimationFrame(() => {
                    username.classList.add("shake")
                })
            }
            if (isEmailExist) {
                event.preventDefault()

                requestAnimationFrame(() => {
                    email.classList.add("shake")
                })
            }
        })
  </script>
  <script src="/js/settings.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>